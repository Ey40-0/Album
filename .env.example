# Variables de entorno para scripts locales (NUNCA agregues valores reales aquí)
# Copia este archivo como .env (que está ignorado por .gitignore) y completa tus datos.

SUPABASE_URL="https://TU-PROYECTO.supabase.co"

# Service role key (obtenida en Project Settings -> API).
# NUNCA la pongas en el frontend ni la subas al repositorio. Solo se usa para upload_photos.py.
SUPABASE_SERVICE_KEY="TU-SUPABASE-SERVICE-ROLE-KEY"

# Nombre exacto del bucket privado (distingue mayúsculas/minúsculas).
SUPABASE_BUCKET="Album"
